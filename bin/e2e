#!/bin/bash
# End-to-end tests against real dialogs, inside a private Hyprland nested in the session.
#   bin/e2e                 build, then run every flavour (Flea 0.4, Flea 0.3.12, GTK)
#   bin/e2e Flea04          one flavour (Flea04, Flea03 or Gtk); more words are passed to unittest
#   bin/e2e --cleanup       remove what a run that was killed leaves behind
# See docs/e2e.md. Not part of bin/check, which needs no display.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${1:-}" = "--cleanup" ]; then
  exec python3 -I e2e/cleanup.py
fi

for tool in Hyprland hyprctl wtype wl-copy wl-paste busctl dbus-daemon python3; do
  command -v "$tool" >/dev/null || { echo "bin/e2e needs $tool" >&2; exit 2; }
done
[ -x /usr/lib/xdg-desktop-portal ] || { echo "bin/e2e needs xdg-desktop-portal" >&2; exit 2; }

cargo build --locked --quiet
cd e2e
if [ "$#" -eq 0 ]; then
  set -- test_portal
else
  case "$1" in Flea04|Flea03|Gtk) first="test_portal.$1"; shift; set -- "$first" "$@" ;; esac
fi
exec python3 -W ignore::ResourceWarning -m unittest -v "$@"
