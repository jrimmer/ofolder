#!/bin/bash
# Installs the release build to ~/.local/bin/ofolder safely, because a build that crashes at start
# stops every Open and Save dialog in every application.
#   bin/install             build, check the new build runs, keep the previous one, swap atomically
#   bin/install --rollback  put the previous build back
# After installing, open one real dialog (any application's Save or Open). If dialogs stop appearing,
# run bin/install --rollback; `ofolder pause` also makes dialogs pass through untouched.
set -euo pipefail
cd "$(dirname "$0")/.."
dest="$HOME/.local/bin/ofolder"
previous="$HOME/.local/bin/ofolder.previous"

# Stops the running portal by the process id the session bus recorded for its name, never by
# searching process names, which could end somebody else's program. A dialog already open keeps its
# own rails until it closes; the next dialog starts the portal again from the new build.
stop_portal() {
  local name=org.freedesktop.impl.portal.desktop.ofolder pid
  pid=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
    --method org.freedesktop.DBus.GetConnectionUnixProcessID "$name" 2>/dev/null |
    sed -n 's/^(uint32 \([0-9][0-9]*\),)$/\1/p') || true
  if [ -z "$pid" ]; then
    echo "the portal is not running, so there was nothing to stop"
  elif [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = ofolder ]; then
    kill "$pid" && echo "stopped the running portal (process $pid)"
  else
    echo "process $pid holds the portal's name but is not ofolder, so it was left alone" >&2
  fi
}

if [ "${1:-}" = "--rollback" ]; then
  [ -x "$previous" ] || { echo "there is no previous build at $previous" >&2; exit 1; }
  cp "$previous" "$dest.new" && mv "$dest.new" "$dest"
  stop_portal
  echo "put the previous build back: $("$dest" version)"
  exit 0
fi

cargo build --release --locked --quiet
new=target/release/ofolder

# The new build must at least start and answer, as the portal will need it to.
"$new" version >/dev/null
XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}" "$new" status >/dev/null
echo "the new build starts: $("$new" version)"
# The portal's own start-up, without claiming its name, so the running portal is not disturbed. A
# build that fails here would stop every dialog once it replaces the installed one.
if ! "$new" portal --check; then
  echo "the new build fails its portal check, so the installed build was not touched" >&2
  exit 1
fi

# praeco, the update tool, is fetched and checked against its pinned SHA-256 before the swap, so a
# bad download stops the install with the installed build still in place.
praeco_dir=$(mktemp -d)
trap 'rm -rf "$praeco_dir"' EXIT
scripts/get-praeco "$praeco_dir" || {
  echo "praeco could not be fetched or does not match its pinned SHA-256, so the installed build was not touched" >&2
  exit 1
}
mkdir -p "$HOME/.local/lib/ofolder"
install -m755 "$praeco_dir/praeco" "$HOME/.local/lib/ofolder/praeco.new"
mv "$HOME/.local/lib/ofolder/praeco.new" "$HOME/.local/lib/ofolder/praeco"
echo "$("$HOME/.local/lib/ofolder/praeco" --version) (verified against its pinned SHA-256) is at $HOME/.local/lib/ofolder/praeco"

[ -x "$dest" ] && cp -p "$dest" "$previous"
cp "$new" "$dest.new"
mv "$dest.new" "$dest"
cmp "$new" "$dest"
stop_portal   # the portal starts again from the new build on the next dialog
echo "installed $dest (the previous build is kept as $previous)"
echo "now open one real Save or Open dialog; if dialogs stop appearing: bin/install --rollback"
