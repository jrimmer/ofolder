#!/bin/bash
# The gate: formatting, clippy, tests, and the architecture guards.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n== %s\n' "$*"; }

step "rustfmt"
cargo fmt --all --check

step "clippy"
cargo clippy --workspace --all-targets --locked -- -D warnings

step "tests"
cargo test --workspace --locked

step "release tarball layout and the praeco fetch (no network)"
sh scripts/test-release-tarball

step "the guard script, repair --watch and uninstall (no display needed)"
cargo build --locked --quiet
python3 -W ignore -m unittest discover -s e2e -p 'test_guard.py'
python3 -W ignore -m unittest discover -s e2e -p 'test_uninstall.py'

step "guard: core stays free of gpui, D-Bus and accessibility crates"
if cargo tree --locked -p ofolder-core -e normal,build --prefix none | grep -E '^(gpui|zbus|atspi)' >/dev/null; then
  echo "ofolder-core depends on gpui, zbus or atspi:" >&2
  cargo tree --locked -p ofolder-core -e normal,build --prefix none | grep -E '^(gpui|zbus|atspi)' >&2
  exit 1
fi
echo ok
